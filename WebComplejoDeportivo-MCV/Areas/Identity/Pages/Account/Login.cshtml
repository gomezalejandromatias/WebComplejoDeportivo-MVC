

@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-md-7 col-lg-5">

            <div class="card shadow border-0 rounded-4">

                <div class="card-body p-4 p-md-5">

                    <!-- TÍTULO -->
                    <div class="text-center mb-4">

                        <h2 class="fw-bold">
                            Iniciar sesión
                        </h2>

                        <p class="text-muted">
                            Ingresá a tu cuenta para administrar tu complejo deportivo
                        </p>

                    </div>


                    <!-- FORMULARIO -->
                    <form id="account" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"
                             role="alert">
                        </div>


                        <!-- EMAIL -->
                        <div class="form-floating mb-3">

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="username"
                                   aria-required="true"
                                   placeholder="nombre@ejemplo.com" />

                            <label asp-for="Input.Email">
                                Correo electrónico
                            </label>

                            <span asp-validation-for="Input.Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- CONTRASEÑA -->
                        <div class="form-floating mb-3">

                            <input asp-for="Input.Password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   aria-required="true"
                                   placeholder="Contraseña" />

                            <label asp-for="Input.Password">
                                Contraseña
                            </label>

                            <span asp-validation-for="Input.Password"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- RECORDARME -->
                        <div class="form-check mb-4">

                            <input class="form-check-input"
                                   asp-for="Input.RememberMe" />

                            <label class="form-check-label"
                                   asp-for="Input.RememberMe">
                                Recordarme
                            </label>

                        </div>


                        <!-- BOTÓN LOGIN -->
                        <div class="d-grid mb-3">

                            <button id="login-submit"
                                    type="submit"
                                    class="btn btn-dark btn-lg">

                                Iniciar sesión

                            </button>

                        </div>


                        <!-- OLVIDÉ CONTRASEÑA -->
                        <div class="text-center">

                            <a id="forgot-password"
                               asp-page="./ForgotPassword"
                               class="text-decoration-none">

                                ¿Olvidaste tu contraseña?

                            </a>

                        </div>

                    </form>

                </div>

            </div>


            <!-- REGISTRO -->
            <div class="text-center mt-4">

                <span class="text-muted">
                    ¿Todavía no tenés una cuenta?
                </span>

                <a asp-page="./Register"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="fw-semibold text-decoration-none">

                    Registrate

                </a>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
