@page
@model RegisterModel

@{
    ViewData["Title"] = "Registrarse";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-md-7 col-lg-5">

            <div class="card shadow border-0 rounded-4">

                <div class="card-body p-4 p-md-5">

                    <!-- TÍTULO -->
                    <div class="text-center mb-4">

                        <h2 class="fw-bold">
                            Crear cuenta
                        </h2>

                        <p class="text-muted">
                            Registrate para comenzar a utilizar el sistema
                        </p>

                    </div>


                    <!-- FORMULARIO -->
                    <form id="registerForm"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        <!-- ERRORES GENERALES -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"
                             role="alert">
                        </div>


                        <!-- EMAIL -->
                        <div class="form-floating mb-3">

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="username"
                                   aria-required="true"
                                   placeholder="nombre@ejemplo.com" />

                            <label asp-for="Input.Email">
                                Correo electrónico
                            </label>

                            <span asp-validation-for="Input.Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- CONTRASEÑA -->
                        <div class="form-floating mb-3 position-relative">

                            <input asp-for="Input.Password"
                                   class="form-control"
                                   type="password"
                                   id="passwordInput"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="Contraseña"
                                   style="padding-right: 55px;" />

                            <label asp-for="Input.Password">
                                Contraseña
                            </label>

                            <button type="button"
                                    id="togglePassword"
                                    class="btn position-absolute end-0 top-0 h-100"
                                    style="z-index: 5; border: none;"
                                    aria-label="Mostrar contraseña"
                                    aria-pressed="false">
                                <i class="bi bi-eye" id="eyeIcon"></i>
                            </button>

                            <span asp-validation-for="Input.Password"
                                  class="text-danger"></span>
                        </div>


                        <!-- CONFIRMAR CONTRASEÑA -->
                        <div class="form-floating mb-4">

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="Confirmar contraseña" />

                            <label asp-for="Input.ConfirmPassword">
                                Confirmar contraseña
                            </label>

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- BOTÓN -->
                        <div class="d-grid">

                            <button id="registerSubmit"
                                    type="submit"
                                    class="btn btn-dark btn-lg">

                                Crear cuenta

                            </button>

                        </div>

                    </form>

                </div>

            </div>


            <!-- VOLVER AL LOGIN -->
            <div class="text-center mt-4">

                <span class="text-muted">
                    ¿Ya tenés una cuenta?
                </span>

                <a asp-page="./Login"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="fw-semibold text-decoration-none">

                    Iniciar sesión

                </a>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


<script>
    const passwordInput = document.getElementById("passwordInput");
    const togglePassword = document.getElementById("togglePassword");
    const eyeIcon = document.getElementById("eyeIcon");

    togglePassword.addEventListener("click", function() {
        const visible = passwordInput.type === "text";

        passwordInput.type = visible ? "password" : "text";

        eyeIcon.classList.toggle("bi-eye", visible);
        eyeIcon.classList.toggle("bi-eye-slash", !visible);

        togglePassword.setAttribute("aria-pressed", String(!visible));
        togglePassword.setAttribute(
            "aria-label",
            visible ? "Mostrar contraseña" : "Ocultar contraseña"
        );
    });
</script>
