@model IEnumerable<WebComplejoDeportivo_MCV.Models.Cancha>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>

            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioTurno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FotoUrl)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Complejo)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.HorariosDisponibles)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @Html.DisplayFor(model => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Descripcion)
                </td>
                <td>
                    @Html.DisplayFor(model => item.PrecioTurno)
                </td>
                <td>
                    <img src="@item.FotoUrl"
                         width="70"
                         height="70"
                         style="object-fit: cover; border-radius: 8px;" />

                </td>
                <td>
                    @Html.DisplayFor(model => item.Activa)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Complejo)
                </td>

      
           
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Detalle</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Borrar Cnacha</a>
                </td>
            </tr>
        }
    </tbody>
</table>
