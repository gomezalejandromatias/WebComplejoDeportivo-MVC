<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Mi Cancha</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebComplejoDeportivo_MCV.styles.css" asp-append-version="true" />
</head>

<body class="bg-dark text-light">

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary">
            <div class="container">

                <!-- LOGO / NOMBRE -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    ⚽ MI CANCHA
                </a>

                <!-- BOTÓN CELULAR -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- MENÚ -->
                <div class="collapse navbar-collapse" id="menuPrincipal">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Caja/Liquidaciones
                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Reservas"
                               asp-action="Index">
                                Reservas
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Socios"
                               asp-action="Index">
                                Socios
                            </a>
                        </li>

                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-danger"
                               asp-controller="Reservas"
                               asp-action="Create">
                                Reservar cancha
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Canchas"
                               asp-action="Index">
                                Agregar Canchas (Tipos de Canchas del Predio)
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>


    <!-- CONTENIDO DE CADA VISTA -->
    <main>
        @RenderBody()
    </main>


    <!-- FOOTER -->
    <footer class="border-top border-secondary mt-5 py-4 bg-black text-secondary">
        <div class="container text-center">

            <p class="mb-1">
                ⚽ Mi Cancha
            </p>

            <small>
                Sistema de gestión y reservas de complejos deportivos
            </small>

        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
